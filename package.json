{
  "name": "topology-gomoku",
  "version": "1.37.2",
  "private": true,
  "license": "MIT",
  "description": "拓扑五子棋：面向小红书、Bilibili Toy 与微信小程序的跨平台小游戏",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate.ps1",
    "docs:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-docs.ps1",
    "release:check-versions": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-release-versions.ps1",
    "check": "npm test && npm run validate && npm run docs:check",
    "fonts:subset": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/subset-fonts.ps1",
    "build": "npm run build:xiaohongshu",
    "build:xiaohongshu": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "pv:doctor": "node ./video/footsteps-return/scripts/doctor.mjs",
    "pv:lint": "hyperframes lint ./video/footsteps-return",
    "pv:validate": "node ./video/footsteps-return/scripts/validate-manifest.mjs && hyperframes check ./video/footsteps-return",
    "pv:inspect": "hyperframes check ./video/footsteps-return",
    "pv:preview": "hyperframes preview ./video/footsteps-return --no-open",
    "pv:game-render:verify": "node ./video/footsteps-return/scripts/verify-game-render.mjs",
    "pv:voice": "node ./video/footsteps-return/scripts/voice.mjs",
    "pv:voice:auditions": "uv run python ./video/footsteps-return/scripts/generate_voice_auditions.py",
    "pv:score": "powershell -NoProfile -ExecutionPolicy Bypass -File ./video/footsteps-return/scripts/render-score.ps1",
    "pv:render:draft": "hyperframes render ./video/footsteps-return --fps 60 --quality draft --output ./video/footsteps-return/renders/footsteps-return-draft.mp4",
    "pv:render:4k": "hyperframes render ./video/footsteps-return --fps 60 --quality high --resolution landscape-4k --output ./video/footsteps-return/renders/footsteps-return-4k.mp4"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hyperframes/shader-transitions": "0.8.18",
    "@tonejs/midi": "2.0.28",
    "gsap": "3.14.2",
    "hyperframes": "0.8.18",
    "playwright": "1.62.1",
    "three": "0.185.1",
    "tone": "15.1.22"
  }
}
