  "form": [
    { "id": "intro", "start": 0, "end": 21.502667, "identity": "The cell is discovered one pitch at a time: sparse piano, double-bass harmonics and unfilled air.", "density": "very sparse", "narrationStrategy": "No sustained midrange beneath sentences; at least 1.2 seconds of breath around clause endings.", "resolution": "C5 hangs into silence before the Plane card." },
    { "id": "plane", "start": 21.502667, "end": 37.762667, "identity": "Stable prime-form statement D–F–G–A–C in even quarter-note footsteps, answered without distortion.", "density": "sparse chamber", "narrationStrategy": "Piano carries identity; strings answer above and below the Chinese male-voice band.", "resolution": "A compact D/A chamber cadence completes before the next card." },
    { "id": "cylinder", "start": 37.762667, "end": 56.601334, "identity": "One five-step cello pizzicato loop travels from left to right while the vertical harmony remains bounded.", "density": "single ostinato", "narrationStrategy": "Short pizzicati leave consonants unobscured; no pad under the two narration cues.", "resolution": "The third orbit lengthens its last C and releases before Torus." },
    { "id": "torus", "start": 56.601334, "end": 75.781334, "identity": "Two pentatonic cycles use different internal spacing and periods, drifting in and out of coincidence.", "density": "two interlocked lines", "narrationStrategy": "Violin II and viola stay light and separated by register; piano only marks structural corners.", "resolution": "Both cycles stop independently, leaving a full-beat seam into Mobius." },
    { "id": "mobius", "start": 75.781334, "end": 93.894667, "identity": "The prime contour returns in retrograde C–A–G–F–D; bow crescendi create a reverse-envelope illusion without sampled reversal.", "density": "mirrored sparse", "narrationStrategy": "High glass attacks are short; the central speech band remains mostly empty.", "resolution": "The reversed line lands on D and the suspended metal breath dies before Klein." },
    { "id": "klein", "start": 93.894667, "end": 112.626667, "identity": "Bass clarinet states the prime cell while cello answers with its pitch-set mirror in staggered counterpoint.", "density": "dark contrapuntal", "narrationStrategy": "Low lines trade rather than double; horn and bass-drum punctuation remain below narration.", "resolution": "Counterpoint contracts to D/A, followed by a clean card breath." },
    { "id": "projective", "start": 112.626667, "end": 131.38, "identity": "Celesta prime and violin mirror enter 1.5 seconds apart as a glassy mirrored canon, held by weak choir and cold strings.", "density": "transparent canon", "narrationStrategy": "Choir is pianissimo and vowel-only; high-frequency attacks avoid continuous shimmer.", "resolution": "Canon voices exchange direction once, then meet on D/A before Sphere." },
    { "id": "sphere", "start": 131.38, "end": 156.301333, "identity": "The complete cell expands in piano and passes through full strings, restrained horn and light choir toward a voiced D-minor cadence.", "density": "broad but breathing", "narrationStrategy": "Long orchestral tones sit around, not on, narration; horn appears only at harmonic hinges.", "resolution": "D2–A2–D3–F3–A3 resolves completely at 152.8 seconds, not by fade." },
    { "id": "gallery", "start": 156.301333, "end": 163.301333, "identity": "Short memories of prior cells cross-register while the Sphere cadence continues forward.", "density": "receding mosaic", "narrationStrategy": "No narration in the first seven seconds; material thins before the overlapping outro begins.", "resolution": "Celesta closes upward while strings hand a single D to the outro." },
    { "id": "outro", "start": 163.301333, "end": 179.352, "identity": "The prime footsteps return slowly in piano, then descend A–F–D into the final sonority.", "density": "progressively sparse", "narrationStrategy": "Each piano event falls between phrase centers; all sustained voices taper before the logo hold.", "resolution": "Final D/A/D/F chord is allowed to decay past the first end-card second." },
    { "id": "end-card", "start": 179.352, "end": 183.352, "identity": "Residual D sonority until 180.3 seconds, then 3.052 seconds of real silence.", "density": "tail to silence", "narrationStrategy": "No new attack and no noise floor added.", "resolution": "Silence carries the last 3.052 seconds; no hard fade truncates a phrase." }
