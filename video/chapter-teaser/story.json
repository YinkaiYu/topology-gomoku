  "intro": {
    "id": "intro",
    "cues": [
      { "text": "人们总把棋盘的边缘视作尽头。" },
      { "text": "可那些消失在边界上的道路并未中断。" },
      { "text": "它们从另一条边界后延续。" },
      { "text": "将遥远的彼岸重新粘合为近邻。" },
      { "text": "现在，僭越棋盘之人。" },
      { "text": "循着隐藏的连接前行吧。" },
      { "text": "世界的七重轮廓，在你面前依次苏醒。" }
    ]
  },
  "chapters": [
    {
      "id": "plane",
      "act": "ACT. PROLOGUE",
      "chapter": "方庭",
      "manifold": "平面",
      "width": 7,
      "height": 7,
      "start": [1, 3],
      "direction": 0,
      "accent": "#ded7c6",
      "cues": [
        { "text": "绝对的秩序，让世人确信那就是天地的尽头。" },
        { "text": "习惯了有限规则的生灵，真的能察觉。" },
        { "text": "这只是世界的冰山一角吗？" }
      ]
    },
    {
      "id": "cylinder",
      "act": "ACT. I",
      "chapter": "回廊",
      "manifold": "圆柱面",
      "width": 7,
      "height": 6,
      "start": [5, 2],
      "direction": 0,
      "accent": "#68aaa2",
      "cues": [
        { "text": "左右相接，上下仍被截断。" },
        { "text": "一端坠入虚无，一端连缀归途。" },
        { "text": "拥有一重循环的世界，该如何丈量远近？" }
      ]
    },
    {
      "id": "torus",
      "act": "ACT. II",
      "chapter": "环游",
      "manifold": "环面",
      "width": 7,
      "height": 6,
      "start": [1, 0],
      "direction": 5,
      "accent": "#667fac",
      "cues": [
        { "text": "天与地交织，首与尾相连。" },
        { "text": "两个方向各自成环。" },
        { "text": "在没有尽头的轮回中，背道而驰的棋子。" },
        { "text": "终将在宿命的交汇处重逢。" }
      ]
    },
    {
      "id": "mobius",
      "act": "ACT. III",
      "chapter": "扭带",
      "manifold": "莫比乌斯环",
      "width": 8,
      "height": 6,
      "start": [6, 0],
      "direction": 1,
      "accent": "#c28a48",
      "cues": [
        { "text": "正与反的界限，被一次荒谬的扭转轻易抹除。" },
        { "text": "在只有一面的世界里，世人迷信黑白分明。" },
        { "text": "却不知正反不过是同源的虚妄。" }
      ]
    },
    {
      "id": "klein",
      "act": "ACT. IV",
      "chapter": "瓶界",
      "manifold": "克莱因瓶",
      "width": 7,
      "height": 6,
      "start": [1, 0],
      "direction": 5,
      "accent": "#aa7448",
      "cues": [
        { "text": "世界在此剥离了内与外的分别。" },
        { "text": "路径会记住你的选择。" },
        { "text": "然后以颠倒的姿态，将因果偿还。" }
      ]
    },
    {
      "id": "projective",
      "act": "ACT. V",
      "chapter": "双生",
      "manifold": "实射影平面",
      "width": 8,
      "height": 8,
      "start": [1, 0],
      "direction": 5,
      "accent": "#8374a8",
      "cues": [
        { "text": "上下左右，全都通向各自的倒影。" },
        { "text": "一次越界是对自我的背叛。" },
        { "text": "而两次倒映又让宿命重新吻合。" },
        { "text": "在双生世界的尽头，你会遇见另一个自己。" }
      ]
    },
    {
      "id": "sphere",
      "act": "ACT. VI",
      "chapter": "归圆",
      "manifold": "球面",
      "width": 7,
      "height": 7,
      "start": [1, 0],
      "direction": 5,
      "accent": "#d7d0ad",
      "cues": [
        { "text": "在最后的世界，四方的棱角褪去。" },
        { "text": "支离破碎的版图归于圆满。" },
        { "text": "人们为了看懂这个世界。" },
        { "text": "将它粗暴地展平成一张带边界的纸。" },
        { "text": "所谓边界，不过是观测者无知的刻痕。" }
      ]
    }
  ],
  "tableau": {
    "id": "seven-worlds",
